<!-- ===== SCRIPTS ===== -->
<script>
  // ===== LOADING SCREEN LOGIC =====
  (function() {
    var loader = document.getElementById('lnxLoader');
    var loaderBar = document.getElementById('lnxLoaderBar');
    if (!loader) return;
    
    function completeLoading() {
      if (loaderBar) {
        loaderBar.style.animation = 'none';
        loaderBar.style.width = '100%';
      }
      loader.classList.add('hidden');
      setTimeout(function() {
        if (loader.parentNode) {
          loader.parentNode.removeChild(loader);
        }
      }, 700);
    }
    
    if (document.readyState === 'complete') {
      setTimeout(completeLoading, 400);
    } else {
      window.addEventListener('load', function() {
        setTimeout(completeLoading, 500);
      });
      setTimeout(function() {
        if (!loader.classList.contains('hidden')) {
          completeLoading();
        }
      }, 10000);
    }
  })();

  // Navbar scroll effect
  const nav = document.getElementById('mainNav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 50);
    document.getElementById('scrollTopBtn').classList.toggle('visible', window.scrollY > 300);
  }, { passive: true });


  // Scroll to top
  document.getElementById('scrollTopBtn').addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Ribbon animation and interactive effects
  const ribbonContainer = document.getElementById('ribbonContainer');
  const ribbonColors = [
    'linear-gradient(45deg, #ff6706, #ff9a3c)',
    'linear-gradient(45deg, #c0ff5d, #8bc34a)',
    'linear-gradient(45deg, #5b6af0, #7c8cf8)',
    'linear-gradient(45deg, #ff4081, #f50057)',
    'linear-gradient(45deg, #00bcd4, #0097a7)',
    'linear-gradient(45deg, #ff9800, #ff5722)',
    'linear-gradient(45deg, #9c27b0, #673ab7)',
    'linear-gradient(45deg, #4caf50, #8bc34a)'
  ];

  // Create dynamic ribbons
  function createRibbons(count = 8) {
    for (let i = 0; i < count; i++) {
      const ribbon = document.createElement('div');
      ribbon.className = 'ribbon';
      
      // Random properties
      const width = 80 + Math.random() * 120;
      const height = 20 + Math.random() * 40;
      const startX = Math.random() * 100;
      const startY = Math.random() * 100;
      const colorIndex = Math.floor(Math.random() * ribbonColors.length);
      const duration = 8 + Math.random() * 8;
      const delay = Math.random() * 5;
      
      // Apply styles
      ribbon.style.width = `${width}px`;
      ribbon.style.height = `${height}px`;
      ribbon.style.background = ribbonColors[colorIndex];
      ribbon.style.left = `${startX}%`;
      ribbon.style.top = `${startY}%`;
      ribbon.style.animationDuration = `${duration}s`;
      ribbon.style.animationDelay = `${delay}s`;
      ribbon.style.opacity = `${0.05 + Math.random() * 0.15}`;
      ribbon.style.filter = `blur(${0.5 + Math.random() * 1.5}px)`;
      ribbon.style.borderRadius = `${2 + Math.random() * 6}px`;
      
      // Add mouse interaction
      ribbon.addEventListener('mouseenter', () => {
        ribbon.style.opacity = '0.3';
        ribbon.style.filter = 'blur(0.5px)';
        ribbon.style.transform = 'scale(1.2)';
      });
      
      ribbon.addEventListener('mouseleave', () => {
        ribbon.style.opacity = `${0.05 + Math.random() * 0.15}`;
        ribbon.style.filter = `blur(${0.5 + Math.random() * 1.5}px)`;
        ribbon.style.transform = 'scale(1)';
      });
      
      ribbonContainer.appendChild(ribbon);
    }
  }

  // Create ribbons on load
  createRibbons(12);

  // Interactive header effects
  const navLinks = document.querySelectorAll('.lnx-nav-links a');
  navLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      // Create a small ribbon effect when hovering over nav links
      const ribbon = document.createElement('div');
      ribbon.className = 'ribbon';
      ribbon.style.width = '60px';
      ribbon.style.height = '4px';
      ribbon.style.background = 'linear-gradient(90deg, #ff6706, #ff9a3c)';
      ribbon.style.position = 'absolute';
      ribbon.style.bottom = '0';
      ribbon.style.left = '50%';
      ribbon.style.transform = 'translateX(-50%)';
      ribbon.style.opacity = '0.8';
      ribbon.style.filter = 'blur(0.5px)';
      ribbon.style.zIndex = '1';
      ribbon.style.animation = 'none';
      
      link.style.position = 'relative';
      link.appendChild(ribbon);
      
      // Remove after animation
      setTimeout(() => {
        if (ribbon.parentNode === link) {
          link.removeChild(ribbon);
        }
      }, 300);
    });
  });

  // Intersection Observer for fade-in animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.product-grid, .software-grid, .app-grid, .music-grid, .product-card, .solution-card').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(30px)';
    el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    observer.observe(el);
  });

  // ===== CUSTOM CURSOR =====
  (function() {
    'use strict';
    if (window.innerWidth < 768) return;

    document.documentElement.classList.add('custom-cursor-active');

    var dot = document.createElement('div');
    dot.className = 'cursor-dot';
    document.body.appendChild(dot);

    var cursor = document.createElement('div');
    cursor.className = 'lnx-cursor';
    cursor.innerHTML = '<div class="lnx-cursor-ring"></div><div class="lnx-cursor-ring-2"></div>';
    document.body.appendChild(cursor);

    var mouseX = 0, mouseY = 0;
    var colors = ['#ff6706','#c0ff5d','#5b6af0','#ff9a3c','#ff4081','#00bcd4'];

    document.addEventListener('mousemove', function(e) {
      mouseX = e.clientX;
      mouseY = e.clientY;
      dot.style.left = mouseX + 'px';
      dot.style.top = mouseY + 'px';
      cursor.style.left = mouseX + 'px';
      cursor.style.top = mouseY + 'px';
      if (Math.random() < 0.15) spawnParticle(mouseX, mouseY);
    });

    function spawnParticle(x, y) {
      var p = document.createElement('div');
      p.className = 'cursor-particle';
      var size = 2 + Math.random() * 4;
      var color = colors[Math.floor(Math.random() * colors.length)];
      p.style.width = size + 'px';
      p.style.height = size + 'px';
      p.style.background = color;
      p.style.boxShadow = '0 0 4px ' + color;
      p.style.left = (x + (Math.random() - 0.5) * 10) + 'px';
      p.style.top = y + 'px';
      p.style.animationDuration = (0.8 + Math.random() * 0.6) + 's';
      document.body.appendChild(p);
      setTimeout(function() {
        if (p.parentNode) p.parentNode.removeChild(p);
      }, 1500);
    }

    document.addEventListener('mousedown', function() {
      cursor.style.width = '40px';
      cursor.style.height = '40px';
      dot.style.width = '6px';
      dot.style.height = '6px';
      for (var i = 0; i < 8; i++) spawnParticle(mouseX, mouseY);
    });

    document.addEventListener('mouseup', function() {
      cursor.style.width = '32px';
      cursor.style.height = '32px';
      dot.style.width = '4px';
      dot.style.height = '4px';
    });

    setInterval(function() {
      if (document.hidden) return;
      if (Math.random() < 0.08) spawnParticle(mouseX, mouseY);
    }, 200);

    document.addEventListener('mouseleave', function() {
      dot.style.opacity = '0';
      cursor.style.opacity = '0';
    });

    document.addEventListener('mouseenter', function() {
      dot.style.opacity = '1';
      cursor.style.opacity = '1';
    });
  })();
</script>

</body>
</html>
