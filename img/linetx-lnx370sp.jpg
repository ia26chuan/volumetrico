// Language switching fallback (vanilla JS)
document.addEventListener('DOMContentLoaded', function() {
  // English language switch
  const enLink = document.getElementById('globalweb_en');
  const bsEnLink = document.getElementById('bs_globalweb_en');
  
  function switchToEnglish() {
    var location = window.location.href;
    var new_location;
    if (location.indexOf(".php") == -1)
      new_location = location + "index_en.php";
    else
      new_location = location.split(".php")[0] + "_en.php";
    window.location = new_location;
  }
  
  if (enLink) {
    enLink.addEventListener('click', switchToEnglish);
  }
  if (bsEnLink) {
    bsEnLink.addEventListener('click', switchToEnglish);
  }
});
</script>

