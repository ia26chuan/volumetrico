  <link rel="stylesheet" type="text/css" href="/html/css/style_cn.css" />
  <style>
    /* ===== RESET & BASE ===== */
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    a, a:link, a:visited, a:hover, a:active {
    text-decoration: none !important;
    }
    body {
      font-family: 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif;
      background: #0a0a0f;
      color: #e0e0e0;
      margin: 0;
      overflow-x: hidden;
    }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; height: auto; display: block; }

    /* ===== NAVBAR ===== */
    .lnx-navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 1000;
      background: rgba(10, 10, 15, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 103, 6, 0.2);
      padding: 0 5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
      transition: all 0.3s ease;
      box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
      overflow: hidden;
    }
    .lnx-navbar::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: 
        linear-gradient(45deg, transparent 30%, rgba(255, 103, 6, 0.05) 50%, transparent 70%),
        linear-gradient(-45deg, transparent 30%, rgba(192, 255, 93, 0.05) 50%, transparent 70%),
        linear-gradient(60deg, transparent 30%, rgba(91, 106, 240, 0.05) 50%, transparent 70%),
        linear-gradient(-60deg, transparent 30%, rgba(255, 154, 60, 0.05) 50%, transparent 70%);
      z-index: -1;
      animation: ribbonFlow 20s linear infinite;
    }
    .lnx-navbar.scrolled {
      background: rgba(10, 10, 15, 0.98);
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
      border-bottom: 1px solid rgba(255, 103, 6, 0.3);
    }
    @keyframes ribbonFlow {
      0% {
        background-position: 0 0, 0 0, 0 0, 0 0;
      }
      100% {
        background-position: 1000px 1000px, -1000px 1000px, 1000px -1000px, -1000px -1000px;
      }
    }
    .ribbon-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: -1;
      overflow: hidden;
    }
    .ribbon {
      position: absolute;
      width: 150px;
      height: 40px;
      opacity: 0.15;
      filter: blur(1px);
      animation: flutter 8s ease-in-out infinite;
      border-radius: 4px;
    }
    .ribbon-1 {
      top: 10%;
      left: -100px;
      background: linear-gradient(45deg, #ff6706, #ff9a3c);
      animation-delay: 0s;
      animation-duration: 10s;
    }
    .ribbon-2 {
      top: 30%;
      right: -100px;
      background: linear-gradient(45deg, #c0ff5d, #8bc34a);
      animation-delay: 1s;
      animation-duration: 12s;
    }
    .ribbon-3 {
      top: 50%;
      left: -100px;
      background: linear-gradient(45deg, #5b6af0, #7c8cf8);
      animation-delay: 2s;
      animation-duration: 9s;
    }
    .ribbon-4 {
      top: 70%;
      right: -100px;
      background: linear-gradient(45deg, #ff4081, #f50057);
      animation-delay: 3s;
      animation-duration: 11s;
    }
    .ribbon-5 {
      top: 20%;
      left: -100px;
      background: linear-gradient(45deg, #00bcd4, #0097a7);
      animation-delay: 4s;
      animation-duration: 13s;
    }
    @keyframes flutter {
      0%, 100% {
        transform: translateX(0) translateY(0) rotate(0deg);
        opacity: 0.1;
      }
      25% {
        transform: translateX(calc(100vw + 200px)) translateY(20px) rotate(5deg);
        opacity: 0.2;
      }
      50% {
        transform: translateX(calc(50vw + 100px)) translateY(-10px) rotate(-3deg);
        opacity: 0.15;
      }
      75% {
        transform: translateX(calc(75vw + 150px)) translateY(15px) rotate(2deg);
        opacity: 0.18;
      }
    }
    .lnx-logo img { 
      height: 42px; 
      transition: transform 0.3s ease;
    }
    .lnx-logo:hover img {
      transform: scale(1.05);
    }
    .lnx-nav-links { 
      display: flex; 
      gap: 2.5rem; 
      list-style: none; 
      margin: 0; 
      padding: 0; 
      align-items: center;
    }
    .lnx-nav-links a {
      color: #e0e0e0;
      font-size: 0.95rem;
      font-weight: 500;
      padding: 8px 0;
      position: relative;
      transition: color 0.2s;
    }
    .lnx-nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, #ff6706, #ff9a3c);
      transition: width 0.3s ease;
    }
    .lnx-nav-links a:hover { 
      color: #ff6706; 
    }
    .lnx-nav-links a:hover::after {
      width: 100%;
    }
    .lnx-nav-cta {
      background: linear-gradient(135deg, #ff6706, #ff9a3c);
      color: #fff !important;
      padding: 10px 24px !important;
      border-radius: 8px;
      border: none !important;
      font-weight: 600 !important;
      transition: all 0.3s ease !important;
      box-shadow: 0 4px 15px rgba(255, 103, 6, 0.3);
    }
    .lnx-nav-cta:hover { 
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 103, 6, 0.5);
      opacity: 1 !important;
    }
    .lnx-nav-lang {
      color: #aaa;
      font-size: 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 6px 12px;
      border-radius: 6px;
      transition: all 0.2s;
      background: rgba(255, 255, 255, 0.05);
    }
    .lnx-nav-lang:hover { 
      border-color: #ff6706; 
      color: #ff6706; 
      background: rgba(255, 103, 6, 0.1);
      box-shadow: 0 2px 8px rgba(255, 103, 6, 0.2);
    }
    .lnx-hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 8px;
      background: transparent;
      border: none;
    }
    .lnx-hamburger span {
      display: block; 
      width: 24px; 
      height: 2px;
      background: #e0e0e0; 
      border-radius: 2px;
      transition: all 0.3s;
    }
    .lnx-hamburger.active span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
      background: #ff6706;
    }
    .lnx-hamburger.active span:nth-child(2) {
      opacity: 0;
    }
    .lnx-hamburger.active span:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -6px);
      background: #ff6706;
    }
    .lnx-mobile-menu {
      display: none;
      position: fixed;
      top: 72px; 
      left: 0; 
      right: 0;
      background: rgba(10, 10, 15, 0.98);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 103, 6, 0.2);
      padding: 1rem 5%;
      z-index: 999;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }
    .lnx-mobile-menu.open { 
      display: block; 
      animation: slideDown 0.3s ease;
    }
    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .lnx-mobile-menu ul { 
      list-style: none; 
      margin: 0; 
      padding: 0; 
    }
    .lnx-mobile-menu li { 
      border-bottom: 1px solid rgba(255, 255, 255, 0.05); 
    }
    .lnx-mobile-menu li:last-child {
      border-bottom: none;
    }
    .lnx-mobile-menu a {
      display: block; 
      padding: 16px 0;
      color: #e0e0e0; 
      font-size: 1rem;
      font-weight: 500;
      transition: color 0.2s, padding-left 0.2s;
    }
    .lnx-mobile-menu a:hover { 
      color: #ff6706; 
      padding-left: 8px;
    }
    .lnx-mobile-menu .lnx-nav-cta {
      margin-top: 1rem;
      display: inline-block;
    }
    .lnx-mobile-menu .lnx-nav-lang {
      margin-top: 1rem;
      display: inline-block;
    }

    /* ===== HERO SECTION ===== */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      background: #0a0a0f;
    }
    .hero-video {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      opacity: 0.35;
      z-index: 0;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(10,10,15,0.85) 40%, rgba(255,103,6,0.08) 100%);
      z-index: 1;
    }
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 1200px;
      margin: 0 auto;
      padding: 120px 1% 80px;
      width: 100%;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,103,6,0.15);
      border: 1px solid rgba(255,103,6,0.4);
      color: #ff9a3c;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 20px;
      margin-bottom: 1.5rem;
    }
    .hero-badge::before {
      content: '';
      width: 6px; height: 6px;
      background: #ff6706;
      border-radius: 50%;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.4); }
    }
    .hero h1 {
      font-size: clamp(2.2rem, 5vw, 3rem);
      font-weight: 800;
      line-height: 1.3;
      color: #fff;
      margin: 0 0 1rem;
    }
    .hero h1 .accent { color: #c0ff5d; font-style: italic; }
    .hero h1 .accent-orange { color: #ff6706; }
    .hero h1 .reg-mark { font-size: 0.5em; vertical-align: super; line-height: 1; margin-left: 0.4em; }
    .hero-sub {
      font-size: clamp(1rem, 2vw, 1.15rem);
      color: #aaa;
      max-width: 600px;
      line-height: 1.7;
      margin-bottom: 2rem;
    }
    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 2.5rem;
    }
    .hero-tag {
      background: rgba(192,255,93,0.08);
      border: 1px solid rgba(192,255,93,0.25);
      color: #c0ff5d;
      font-size: 0.8rem;
      padding: 5px 12px;
      border-radius: 4px;
      font-weight: 500;
    }
    .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
    .btn-primary-lnx {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, #ff6706, #ff9a3c);
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
      padding: 14px 32px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 20px rgba(255,103,6,0.35);
    }
    .btn-primary-lnx:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(255,103,6,0.5);
      color: #fff;
    }
    .btn-outline-lnx {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: transparent;
      color: #fff;
      font-size: 1rem;
      text-decoration: none; 
      font-weight: 600;
      padding: 13px 32px;
      border-radius: 8px;
      border: 1.5px solid rgba(255,255,255,0.3);
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
    }
    .btn-outline-lnx:hover {
      border-color: #ff6706;
      background: rgba(255,103,6,0.08);
      color: #fff;
    }
    .hero-stats {
      display: flex;
      gap: 3rem;
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(255,255,255,0.08);
      flex-wrap: wrap;
    }
    .hero-stat-num {
      font-size: 2rem;
      font-weight: 800;
      color: #ff6706;
      line-height: 1;
    }
    .hero-stat-label {
      font-size: 0.8rem;
      color: #888;
      margin-top: 4px;
    }

    /* ===== SECTION COMMON ===== */
    .section-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1%;
    }
    .section-label {
      display: inline-block;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #ff6706;
      margin-bottom: 0.75rem;
    }
    .section-title {
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      font-weight: 800;
      color: #fff;
      margin: 0 0 1rem;
      line-height: 1.2;
    }
    .section-title .green { color: #c0ff5d; }
    .section-title .orange { color: #ff6706; }
    .section-desc {
      color: #999;
      font-size: 1rem;
      line-height: 1.7;
      max-width: 560px;
    }

    /* ===== FEATURED PRODUCT (LX9) ===== */
    .featured-hero {
      position: relative;
      overflow: hidden;
      cursor: pointer;
    }
    .featured-hero img.bg-img {
      width: 100%;
      display: block;
      transition: transform 0.6s ease;
    }
    .featured-hero:hover img.bg-img { transform: scale(1.02); }
    .featured-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to left, rgba(10,10,15,0.7) 0%, transparent 60%);
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 5%;
    }
    .featured-hero-text { text-align: right; max-width: 480px; }
    .featured-hero-text h2 {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 800;
      color: #fff;
      margin: 0 0 0.5rem;
    }
    .featured-hero-text h2 .green { color: #c0ff5d; }
    .featured-hero-text h3 {
      font-size: clamp(1rem, 2vw, 1.4rem);
      color: rgba(255,255,255,0.8);
      font-weight: 400;
      margin: 0 0 1.5rem;
    }
    .spec-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: flex-end;
    }
    .spec-chip {
      background: rgba(192,255,93,0.1);
      border: 1px solid rgba(192,255,93,0.3);
      color: #c0ff5d;
      font-size: 0.78rem;
      padding: 4px 12px;
      border-radius: 20px;
      font-weight: 500;
    }

    /* ===== PRODUCT CARD SECTION ===== */
    .product-section {
      padding: 80px 0;
    }
    .product-section.dark { background: #0d0d14; }
    .product-section.darker { background: #080810; }
    .product-section.light { background: #f4f6fa; }
    .product-section.light .section-title { color: #1a1a2e; }
    .product-section.light .section-desc { color: #555; }
    .product-section.light p { color: #444; }

    .product-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .product-grid.reverse { direction: rtl; }
    .product-grid.reverse > * { direction: ltr; }

    .product-img-wrap {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
    }
    .product-img-wrap img {
      width: 100%;
      transition: transform 0.5s ease;
    }
    .product-img-wrap:hover img { transform: scale(1.04); }

    .product-info { padding: 10px 0; }
    .product-protocols {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 1rem 0;
    }
    .protocol-tag {
      background: rgba(255,103,6,0.12);
      border: 1px solid rgba(255,103,6,0.3);
      color: #ff9a3c;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 4px;
      letter-spacing: 0.05em;
    }
    .feature-list {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0;
    }
    .feature-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      font-size: 0.95rem;
      color: #bbb;
      line-height: 1.5;
    }
    .feature-list li:last-child { border-bottom: none; }
    .feature-list li::before {
      content: '';
      flex-shrink: 0;
      width: 6px; height: 6px;
      background: #ff6706;
      border-radius: 50%;
      margin-top: 7px;
    }
    .feature-list li strong { color: #ff6706; }
    .feature-list.green-dot li::before { background: #c0ff5d; }
    .feature-list.green-dot li strong { color: #c0ff5d; }

    .product-note {
      background: rgba(255,255,255,0.04);
      border-left: 3px solid #ff6706;
      padding: 12px 16px;
      border-radius: 0 8px 8px 0;
      font-size: 0.85rem;
      color: #999;
      margin: 1.5rem 0;
      line-height: 1.6;
    }
    .product-note.green { border-left-color: #c0ff5d; }

    .btn-group-lnx { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 1.5rem; }
    .btn-sm-primary {
      position: relative;
      display: inline-flex;
      z-index: 1;
      align-items: center;
      gap: 6px;
      background: linear-gradient(
       90deg,
       #ff6b6b,
       #ff8c42,
       #ffd93d,
       #6bcf7f,
       #4d96ff,
       #9b59b6,
       #ff6b6b
      );
      color: #fff;
      font-size: 0.9rem;
      font-weight: 600;
      padding: 10px 24px;
      border-radius: 6px;
      background-size: 400% 100%;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 3px 12px rgba(255,103,6,0.3);
      animation: rainbowFlow 10s linear infinite;
    }
    /* 彩虹流动动画 */
    @keyframes rainbowFlow {
      0% {
        background-position: 0% 50%;
      }
      100% {
        background-position: 400% 50%;
      }
    }

    .btn-sm-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255,103,6,0.45);
      color: #fff;
    }
    .btn-sm-outline {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: transparent;
      color: #ccc;
      font-size: 0.9rem;
      font-weight: 600;
      padding: 9px 24px;
      border-radius: 6px;
      border: 1.5px solid rgba(255,255,255,0.2);
      transition: border-color 0.2s, color 0.2s;
    }
    .btn-sm-outline:hover { border-color: #ff6706; color: #ff6706; }

    /* ===== VIDEO SECTION (LNX-378) ===== */
    .video-section {
      position: relative;
      overflow: hidden;
      padding: 100px 0;
      background: #080810;
    }
    .video-bg {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      opacity: 0.2;
      z-index: 0;
    }
    .video-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(8,8,16,0.9) 50%, rgba(255,103,6,0.05));
      z-index: 1;
    }
    .video-content {
      position: relative;
      z-index: 2;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1%;
    }

    /* ===== SOFTWARE SECTION ===== */
    .software-section {
      padding: 100px 0;
      background: linear-gradient(180deg, #0d0d14 0%, #0a0a0f 100%);
    }
    .software-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0px;
      align-items: center;
    }
    .software-screenshot {
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
      border: 1px solid rgba(192,255,93,0.1);
    }
    .software-screenshot img { width: 100%; }

    /* ===== APP SECTION ===== */
    .app-section {
      padding: 100px 0;
      background: linear-gradient(135deg, #f0f4ff 0%, #e8edf8 100%);
    }
    .app-section .section-label { color: #5b6af0; }
    .app-section .section-title { color: #1a1a2e; }
    .app-section .section-desc { color: #555; }
    .app-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .app-img-wrap {
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(91,106,240,0.15);
    }
    .app-img-wrap img { width: 100%; }
    .app-feature-list {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0;
    }
    .app-feature-list li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid rgba(0,0,0,0.06);
      font-size: 0.95rem;
      color: #444;
    }
    .app-feature-list li:last-child { border-bottom: none; }
    .app-feature-list li::before {
      content: '✓';
      flex-shrink: 0;
      width: 20px; height: 20px;
      background: #5b6af0;
      color: #fff;
      font-size: 0.7rem;
      font-weight: 700;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 2px;
    }
    .btn-app-download {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, #5b6af0, #7c8cf8);
      color: #fff;
      font-size: 0.95rem;
      font-weight: 600;
      padding: 12px 28px;
      border-radius: 8px;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 16px rgba(91,106,240,0.35);
    }
    .btn-app-download:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(91,106,240,0.5);
      color: #fff;
    }

    /* ===== PRODUCT CARDS GRID ===== */
    .cards-section {
      padding: 100px 0;
      background: #0a0a0f;
    }
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 3rem;
    }
    .product-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 16px;
      overflow: hidden;
      transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
    }
    .product-card:hover {
      transform: translateY(-6px);
      border-color: rgba(255,103,6,0.3);
      box-shadow: 0 16px 40px rgba(0,0,0,0.4);
    }
    .product-card-img {
      overflow: hidden;
      background: rgba(255,255,255,0.02);
      padding: 20px;
    }
    .product-card-img img {
      width: 100%;
      height: 180px;
      object-fit: contain;
      transition: transform 0.4s;
    }
    .product-card:hover .product-card-img img { transform: scale(1.06); }
    .product-card-body { padding: 20px; }
    .product-card-title {
      font-size: 1rem;
      font-weight: 700;
      color: #fff;
      margin: 0 0 8px;
    }
    .product-card-desc {
      font-size: 0.85rem;
      color: #888;
      line-height: 1.6;
      margin-bottom: 16px;
    }
    .product-card-specs {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 16px;
    }
    .spec-badge {
      background: rgba(255,103,6,0.1);
      border: 1px solid rgba(255,103,6,0.2);
      color: #ff9a3c;
      font-size: 0.7rem;
      padding: 3px 8px;
      border-radius: 3px;
      font-weight: 600;
    }
    .product-card-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #ff6706;
      font-size: 0.85rem;
      font-weight: 600;
      transition: gap 0.2s;
    }
    .product-card-link:hover { gap: 10px; color: #ff9a3c; }
    .product-card-link::after { content: '→'; }

    /* ===== MUSIC CONTROLLER SECTION ===== */
    .music-section {
      padding: 100px 0;
      background: #0d0d14;
      position: relative;
      overflow: hidden;
    }
    .music-section::before {
      content: '';
      position: absolute;
      top: -200px; right: -200px;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(192,255,93,0.05) 0%, transparent 70%);
      pointer-events: none;
    }
    .music-grid {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: 60px;
      align-items: start;
    }
    .music-img-stack { display: flex; flex-direction: column; gap: 20px; }
    .music-img-stack img {
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.06);
    }
    .music-features { display: flex; flex-direction: column; gap: 24px; margin: 2rem 0; }
    .music-feature-item {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }
    .music-feature-icon {
      flex-shrink: 0;
      width: 44px; height: 44px;
      background: rgba(255,103,6,0.12);
      border: 1px solid rgba(255,103,6,0.25);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }
    .music-feature-title {
      font-size: 1rem;
      font-weight: 700;
      color: #fff;
      margin: 0 0 4px;
    }
    .music-feature-desc {
      font-size: 0.85rem;
      color: #888;
      line-height: 1.6;
      margin: 0;
    }

    /* ===== RELAY SECTION ===== */
    .relay-section {
      padding: 100px 0;
      background: #0a0a0f;
    }

    /* ===== SOLUTIONS STRIP ===== */
    .solutions-strip {
      padding: 80px 0;
      background: linear-gradient(135deg, #1a0a00 0%, #0d0d14 100%);
      border-top: 1px solid rgba(255,103,6,0.15);
      border-bottom: 1px solid rgba(255,103,6,0.15);
    }
    .solutions-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
      margin-top: 3rem;
    }
    .solution-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 12px;
      padding: 24px 16px;
      text-align: center;
      transition: background 0.3s, border-color 0.3s, transform 0.3s;
      cursor: pointer;
    }
    .solution-card:hover {
      background: rgba(255,103,6,0.08);
      border-color: rgba(255,103,6,0.3);
      transform: translateY(-4px);
    }
    .solution-card img {
      width: 64px; height: 64px;
      object-fit: contain;
      margin: 0 auto 12px;
    }
    .solution-card-title {
      font-size: 0.85rem;
      font-weight: 600;
      color: #ccc;
      line-height: 1.4;
    }
    .solution-card:hover .solution-card-title { color: #ff9a3c; }

    /* ===== FOOTER ===== */
    .lnx-footer {
      background: #060608;
      border-top: 2px solid #ff6706;
      padding: 60px 0 0;
      color: #aaa;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: 40px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 5%;
    }
    .footer-brand img { height: 36px; margin-bottom: 16px; }
    .footer-brand p { font-size: 0.85rem; line-height: 1.7; color: #777; }
    .footer-col h4 {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #fff;
      margin: 0 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(255,103,6,0.3);
    }
    .footer-col ul { list-style: none; padding: 0; margin: 0; }
    .footer-col li { margin-bottom: 10px; }
    .footer-col a { color: #777; font-size: 0.85rem; transition: color 0.2s; }
    .footer-col a:hover { color: #ff6706; }
    .footer-contact-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 10px;
      font-size: 0.85rem;
    }
    .footer-contact-item .label { color: #ff6706; flex-shrink: 0; }
    .footer-contact-item a { color: #aaa; }
    .footer-contact-item a:hover { color: #ff6706; }
    .footer-wechat img { width: 120px; border-radius: 8px; margin-bottom: 12px; }

    /* ===== CUSTOM CURSOR ===== */
    html.custom-cursor-active { cursor: none; }
    .cursor-dot {
      position: fixed;
      pointer-events: none;
      z-index: 999999;
      width: 4px;
      height: 4px;
      background: #ff6706;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.1s, height 0.1s;
      box-shadow: 0 0 8px rgba(255, 103, 6, 0.6);
    }
    .lnx-cursor {
      position: fixed;
      pointer-events: none;
      z-index: 999999;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2px solid transparent;
      background: transparent;
      transform: translate(-50%, -50%);
      transition: width 0.15s, height 0.15s, border-width 0.15s;
      mix-blend-mode: screen;
    }
    .lnx-cursor-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px solid transparent;
      animation: cursorSpin 2s linear infinite;
    }
    .lnx-cursor-ring::before {
      content: '';
      position: absolute;
      top: -2px;
      left: 50%;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      transform: translateX(-50%);
    }
    @keyframes cursorSpin {
      0%   { transform: rotate(0deg);   border-top-color: #ff6706; border-right-color: transparent; border-bottom-color: transparent; border-left-color: transparent; }
      25%  { border-top-color: #c0ff5d; border-right-color: #ff6706; }
      50%  { border-top-color: #5b6af0; border-right-color: #c0ff5d; border-bottom-color: #ff6706; }
      75%  { border-top-color: #ff9a3c; border-right-color: #5b6af0; border-bottom-color: #c0ff5d; border-left-color: #ff6706; }
      100% { transform: rotate(360deg); border-top-color: #ff6706; border-right-color: #ff9a3c; border-bottom-color: #5b6af0; border-left-color: #c0ff5d; }
    }
    .lnx-cursor-ring-2 {
      position: absolute;
      inset: 4px;
      border-radius: 50%;
      border: 2px solid transparent;
      animation: cursorSpin2 1.5s linear infinite reverse;
    }
    .lnx-cursor-ring-2::before {
      content: '';
      position: absolute;
      top: -2px;
      left: 50%;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      transform: translateX(-50%);
    }
    @keyframes cursorSpin2 {
      0%   { transform: rotate(0deg);   border-top-color: #ff4081; border-right-color: transparent; border-bottom-color: transparent; border-left-color: transparent; }
      33%  { border-top-color: #00bcd4; border-right-color: #ff4081; }
      66%  { border-top-color: #ff6706; border-right-color: #00bcd4; border-bottom-color: #ff4081; }
      100% { transform: rotate(360deg); border-top-color: #ff4081; border-right-color: #ff6706; border-bottom-color: #00bcd4; border-left-color: #ff4081; }
    }
    .cursor-particle {
      position: fixed;
      pointer-events: none;
      z-index: 999998;
      border-radius: 50%;
      animation: cursorParticleFall linear forwards;
    }
    @keyframes cursorParticleFall {
      0%   { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(60px) scale(0); }
    }

    /* ===== LOADING SCREEN ===== */
    .lnx-loader {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: #0a0a0f;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: opacity 0.6s ease, visibility 0.6s ease;
    }
    .lnx-loader.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .lnx-loader-logo {
      font-size: 2rem;
      font-weight: 800;
      color: #fff;
      letter-spacing: 2px;
      margin-bottom: 32px;
      position: relative;
    }
    .lnx-loader-logo span {
      color: #ff6706;
    }
    .lnx-loader-ring {
      position: relative;
      width: 60px;
      height: 60px;
      margin-bottom: 24px;
    }
    .lnx-loader-ring::before,
    .lnx-loader-ring::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 3px solid transparent;
    }
    .lnx-loader-ring::before {
      border-top-color: #ff6706;
      border-right-color: #ff9a3c;
      animation: spinRing 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    }
    .lnx-loader-ring::after {
      border-bottom-color: #c0ff5d;
      border-left-color: #5b6af0;
      animation: spinRing 0.8s cubic-bezier(0.5, 0, 0.5, 1) infinite reverse;
      width: 40px;
      height: 40px;
      inset: 10px;
    }
    @keyframes spinRing {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .lnx-loader-bar-wrap {
      width: 200px;
      height: 3px;
      background: rgba(255,255,255,0.08);
      border-radius: 3px;
      overflow: hidden;
      margin-bottom: 12px;
    }
    .lnx-loader-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #ff6706, #ff9a3c, #c0ff5d, #5b6af0, #ff6706);
      background-size: 400% 100%;
      border-radius: 3px;
      animation: progressGradient 2s linear infinite, progressFill 3s ease-out forwards;
    }
    @keyframes progressGradient {
      0% { background-position: 0% 50%; }
      100% { background-position: 400% 50%; }
    }
    @keyframes progressFill {
      0% { width: 0%; }
      50% { width: 65%; }
      85% { width: 85%; }
      100% { width: 100%; }
    }
    .lnx-loader-text {
      font-size: 0.8rem;
      color: #666;
      letter-spacing: 0.15em;
      animation: textPulse 1.5s ease-in-out infinite;
    }
    @keyframes textPulse {
      0%, 100% { opacity: 0.5; }
      50% { opacity: 1; }
    }
    .lnx-loader-dots::after {
      content: '';
      animation: dots 1.5s steps(4, end) infinite;
    }
    @keyframes dots {
      0% { content: ''; }
      25% { content: '.'; }
      50% { content: '..'; }
      75% { content: '...'; }
      100% { content: ''; }
    }
    .lnx-loader-particles {
      position: absolute;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: hidden;
    }
    .lnx-loader-particle {
      position: absolute;
      width: 4px;
      height: 4px;
      background: #ff6706;
      border-radius: 50%;
      opacity: 0;
      animation: particleFloat 3s ease-in-out infinite;
    }
    .lnx-loader-particle:nth-child(1) { left: 20%; top: 30%; animation-delay: 0s; background: #ff6706; }
    .lnx-loader-particle:nth-child(2) { left: 70%; top: 20%; animation-delay: 0.5s; background: #c0ff5d; }
    .lnx-loader-particle:nth-child(3) { left: 40%; top: 70%; animation-delay: 1s; background: #5b6af0; }
    .lnx-loader-particle:nth-child(4) { left: 80%; top: 60%; animation-delay: 1.5s; background: #ff9a3c; }
    .lnx-loader-particle:nth-child(5) { left: 10%; top: 50%; animation-delay: 2s; background: #ff4081; }
    .lnx-loader-particle:nth-child(6) { left: 60%; top: 80%; animation-delay: 2.5s; background: #00bcd4; }
    @keyframes particleFloat {
      0%, 100% { opacity: 0; transform: translateY(0) scale(0); }
      30% { opacity: 0.8; transform: translateY(-30px) scale(1); }
      60% { opacity: 0.4; transform: translateY(-60px) scale(0.6); }
      100% { opacity: 0; transform: translateY(-100px) scale(0); }
    }
    /* ===== SCROLL TO TOP ===== */
    .scroll-top {
      position: fixed;
      bottom: 30px; right: 30px;
      width: 44px; height: 44px;
      background: linear-gradient(135deg, #ff6706, #ff9a3c);
      color: #fff;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      box-shadow: 0 4px 16px rgba(255,103,6,0.4);
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.3s, transform 0.3s;
      z-index: 999;
    }
    .scroll-top.visible { opacity: 1; transform: translateY(0); }
    .scroll-top:hover { box-shadow: 0 6px 24px rgba(255,103,6,0.6); }

    /* ===== DIVIDER ===== */
    .section-divider {
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(255,103,6,0.3), transparent);
      margin: 0;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 992px) {
      .product-grid, .software-grid, .app-grid, .music-grid { grid-template-columns: 1fr; gap: 40px; }
      .product-grid.reverse { direction: ltr; }
      .solutions-grid { grid-template-columns: repeat(3, 1fr); }
      .cards-grid { grid-template-columns: repeat(2, 1fr); }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .lnx-nav-links { display: none; }
      .lnx-hamburger { display: flex; }
      .hero-stats { gap: 2rem; }
    }
    @media (max-width: 600px) {
      .solutions-grid { grid-template-columns: repeat(2, 1fr); }
      .cards-grid { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr; }
      .hero-actions { flex-direction: column; }
      .btn-group-lnx { flex-direction: column; }
      .featured-hero-overlay { background: linear-gradient(to top, rgba(10,10,15,0.9) 0%, transparent 60%); align-items: flex-end; justify-content: center; }
      .featured-hero-text { text-align: center; }
      .spec-chips { justify-content: center; }
    }

/* 移动端响应式样式 */
@media (max-width: 768px) {
  .lnxeffect-grid-responsive {
    grid-template-columns: 1fr !important;
    gap: 40px !important;
  }
  
  /* 移动端图片显示更大 */
  .lnxeffect-image {
    order: 2;
    margin-top: 0;
  }
  
  /* 移动端文字区域 */
  .lnxeffect-text {
    order: 1;
  }
  
  /* 移动端图片占满宽度，显示更大 */
  .lnxeffect-image img {
    width: 100%;
    max-width: 100%;
    height: auto;
  }
}
/* 平板设备调整（可选） */
@media (min-width: 769px) and (max-width: 1024px) {
  .lnxeffect-grid-responsive {
    grid-template-columns: 1fr 1.2fr !important;
    gap: 40px !important;
  }
}
  </style>
</head>
<body>
<!-- ===== LOADING SCREEN ===== -->
<div class="lnx-loader" id="lnxLoader" role="status" aria-label="加载中">
  <div class="lnx-loader-particles">
    <div class="lnx-loader-particle"></div>
    <div class="lnx-loader-particle"></div>
    <div class="lnx-loader-particle"></div>
    <div class="lnx-loader-particle"></div>
    <div class="lnx-loader-particle"></div>
    <div class="lnx-loader-particle"></div>
  </div>
  <div class="lnx-loader-logo">LINETX <span>·</span></div>
  <div class="lnx-loader-ring"></div>
  <div class="lnx-loader-bar-wrap">
    <div class="lnx-loader-bar" id="lnxLoaderBar"></div>
  </div>
  <div class="lnx-loader-text">加载中<span class="lnx-loader-dots"></span></div>
</div>

<!-- ===== MODERN NAVBAR ===== -->
<style>
  /* Flame glow animation for nav links */
  .lnx-nav-links li a {
    position: relative;
    transition: all 0.3s ease;
    text-shadow: none;
    text-decoration: none !important; /* Remove underline by default */
    padding:5px;
  }

  /* Base flame glow effect on hover */
  .lnx-nav-links li a:hover {
    animation: flameFlicker 0.8s ease-in-out infinite;
    color: #ff6b35 !important;
    text-decoration: none !important; /* Remove underline on hover */
  }

  /* Keyframes for flickering flame effect */
  @keyframes flameFlicker {
    0% {
      text-shadow: 0 0 2px #ff4d1e, 0 0 4px #ff6b35, 0 0 6px #ff8c42;
      color: #ff6b35;
    }
    25% {
      text-shadow: 0 0 4px #ff3a00, 0 0 8px #ff6b35, 0 0 12px #ffa559;
      color: #ff8c42;
    }
    50% {
      text-shadow: 0 0 6px #ff5e2e, 0 0 10px #ff8c42, 0 0 14px #ffb347;
      color: #ffa559;
    }
    75% {
      text-shadow: 0 0 3px #ff3a00, 0 0 6px #ff6b35, 0 0 9px #ff8c42;
      color: #ff7a3a;
    }
    100% {
      text-shadow: 0 0 2px #ff4d1e, 0 0 4px #ff6b35, 0 0 6px #ff8c42;
      color: #ff6b35;
    }
  }

  /* Optional: Continuous subtle glow on active/current page */
